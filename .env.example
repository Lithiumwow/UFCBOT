# Copy this file to ".env" and fill in your values. Never commit the real .env file.

# Bot token from https://discord.com/developers/applications -> your app -> Bot -> Reset Token
DISCORD_TOKEN=

# Optional: paste a single Discord server (guild) ID here while developing.
# Guild-scoped slash commands sync instantly. Leave blank to sync globally
# (global sync can take up to ~1 hour to propagate the first time).
GUILD_ID=

# Path to the SQLite database file (created automatically on first run)
DB_PATH=bets.db

# How often (in hours) to refresh the cached list of upcoming/live UFC
# events. Defaults to 72 (3 days) if left blank.
EVENT_REFRESH_HOURS=72

# Static GBP->USD / EUR->USD rates shown alongside cash amounts. Not live.
GBP_TO_USD_RATE=1.33
EUR_TO_USD_RATE=1.15

# PebbleHost panel API (Pterodactyl client key) — powers /restart
PANEL_API_URL=https://panel.pebblehost.com
PANEL_API_KEY=
PANEL_SERVER_ID=
